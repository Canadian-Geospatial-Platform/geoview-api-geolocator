{
    "url": "https://geolocator.api.geo.ca/geolocation/_PARAM1_/locate",
    "urlParams": {
        "param1": "lang"
    },
    "staticParams": {
        "expand": "component"
    },
    "urlCodeTables": {},
    "lookup": {
        "in": {
            "q": "q"
        },
        "out": {
            "structure": {
                "type": "list"
            },
            "data": {
                "name": {
                    "field": "title",
                    "lookup": ""
                },
                "province": {
                    "field": "province",
                    "lookup": ""
                },
                "category": {
                    "field": "category",
                    "lookup": ""
                },
                "lat": {
                    "field": "geometry.coordinates",
                    "lookup": {
                        "type": "array",
                        "field": "1"
                    }
                },
                "lng": {
                    "field": "geometry.coordinates",
                    "lookup": {
                        "type": "array",
                        "field": "0"
                    }
                },
                "bbox": {
                    "field": "bbox",
                    "lookup": ""
                },
                "tag": [{
                        "field": "qualifier",
                        "lookup": ""
                    }
                ]
            }
        }
    }
}
